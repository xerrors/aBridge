{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": [".vitepress/**/*.mts", ".vitepress/theme/**/*.ts", ".vitepress/theme/**/*.vue"]
}
