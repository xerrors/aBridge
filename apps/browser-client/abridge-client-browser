#!/usr/bin/env python3
"""在 Linux 上运行使用原版 aBridge 扩展的独立浏览器设备。"""

import argparse
import base64
import fcntl
import getpass
import hashlib
import json
import os
import pwd
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.request
from contextlib import contextmanager, suppress
from pathlib import Path
from urllib.parse import urlsplit

from playwright.sync_api import Error, sync_playwright

INSTALLATION = Path(__file__).resolve().parent
MAX_MESSAGE = 8192
FAILED = {"status": "failed"}


class BindingMissing(ValueError):
    """扩展已明确缺少预期绑定。"""


def valid_origin(origin: str, allow_http: bool = False) -> str:
    """凭据仅发送至规范化的 HTTPS 或显式信任的 HTTP 来源。"""
    url = urlsplit(origin)
    host = url.hostname or ""
    address = f"[{host}]" if ":" in host else host
    port = url.port
    authority = address if port is None else f"{address}:{port}"
    if (
        not host
        or origin != f"{url.scheme}://{authority}"
        or any(c.isspace() or c in "%\\@*" for c in host)
        or url.scheme not in {"https", "http"}
        or (url.scheme == "http" and not allow_http and host not in {"localhost", "127.0.0.1", "::1"})
    ):
        raise ValueError("invalid server origin")
    if port == (443 if url.scheme == "https" else 80):
        return f"{url.scheme}://{address}"
    return origin


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """禁止跟随携带凭据的请求重定向。"""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        """让携带凭据的重定向请求失败。"""
        return


def device_request(origin: str, path: str, *, body=None, key=None) -> dict:
    """读取设备身份，禁止继承代理或跟随重定向。"""
    headers = {"Content-Type": "application/json"} if body is not None else {"Authorization": f"Bearer {key}"}
    request = urllib.request.Request(origin + path, data=json.dumps(body).encode() if body is not None else None, headers=headers)
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    with opener.open(request, timeout=6) as response:
        device = json.loads(response.read(16384))
    if device["kind"] != "browser" or device["capabilities"] != ["browser"]:
        raise ValueError("a Browser Device Key is required")
    return device


def binding_for(home: Path) -> dict | None:
    """回读扩展已经确认的绑定。"""
    try:
        return json.loads((home / "binding.json").read_text())
    except FileNotFoundError:
        return None


def save_binding(home: Path, binding: dict) -> None:
    """在扩展完成绑定后原子发布设备与版本。"""
    pending = home / "binding.tmp"
    pending.write_text(json.dumps(binding))
    pending.replace(home / "binding.json")


@contextmanager
def connection_page(context):
    """仅向扩展自己的连接页面交付浏览器凭据。"""
    manifest = json.loads((INSTALLATION / "extension/manifest.json").read_text())
    # 发行物的公开密钥固定扩展 ID，重启及升级沿用同一 Profile。
    digest = hashlib.sha256(base64.b64decode(manifest["key"], validate=True)).hexdigest()[:32]
    extension_id = digest.translate(str.maketrans("0123456789abcdef", "abcdefghijklmnop"))
    page = context.new_page()
    try:
        page.goto(f"chrome-extension://{extension_id}/connection.html", timeout=4000)
        yield page
    finally:
        page.close()


def open_browser(playwright, home: Path, origin: str):
    """复制扩展并仅授予配置主机的权限，Chromium 使用私有持久 profile。"""
    url = urlsplit(origin)
    extension = home / "extension"
    shutil.copytree(INSTALLATION / "extension", extension, dirs_exist_ok=True)
    manifest_path = extension / "manifest.json"
    manifest = json.loads(manifest_path.read_text())
    host = url.hostname if ":" not in url.hostname else f"[{url.hostname}]"
    # Chrome 的 match pattern 按主机授权，具体端口仍由登记和兑换的 origin 限定。
    manifest["host_permissions"] = [f"{url.scheme}://{host}/*"]
    manifest_path.chmod(0o600)
    manifest_path.write_text(json.dumps(manifest))
    return playwright.chromium.launch_persistent_context(
        home / "profile",
        channel="chromium",
        headless=True,
        chromium_sandbox=True,
        timeout=9000,
        args=[
            f"--disable-extensions-except={extension}",
            f"--load-extension={extension}",
        ],
    )


def extension_request(page, message: dict, timeout: float = 1):
    """只从扩展的内部连接页发送请求。"""
    return page.evaluate(
        """([message, timeout]) => Promise.race([
            chrome.runtime.sendMessage(message),
            new Promise(resolve => setTimeout(resolve, timeout, null))
        ])""",
        [message, int(timeout * 1000)],
    )


def bind(page, binding: dict, device_key: str) -> None:
    """通过原版扩展的内部页面发起绑定。"""
    origin = binding["browser_origin"]
    message = {"type": "bind_token", "server": origin, "device_key": device_key}
    if origin.startswith("http://"):
        message["http_confirmed_origin"] = origin
    if binding["revision"]:
        message["platform_revision"] = binding["revision"]
    accepted = extension_request(page, message, timeout=5)
    if not accepted or not accepted.get("ok"):
        raise ValueError("binding rejected")


def profile_status(page, timeout: float = 5) -> dict:
    """等待扩展完成本地存储和标签页恢复。"""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        status = extension_request(page, {"type": "status"}, timeout=0.5)
        if status and status.get("ok"):
            return status
        time.sleep(0.1)
    raise TimeoutError("browser status could not be read")


def matches_binding(status: dict, binding: dict, *, legacy: bool = False) -> bool:
    revision = status.get("platform_revision")
    return (
        status.get("configured")
        and status.get("device_id") == binding["device_id"]
        and status.get("server") == binding["browser_origin"]
        and (revision == binding["revision"] or revision is None and (legacy or not binding["revision"]))
    )


def verify_binding(page, binding: dict, *, timeout: float = 7, connected: bool = False) -> None:
    """等待指定版本落盘。平台代理交接还须确认 WebSocket 与 Server 提交成功。"""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        status = extension_request(page, {"type": "status"}, timeout=0.5)
        if status and status.get("authorization_error"):
            raise ValueError("binding failed")
        if status and status.get("ok") and not status.get("authorizing"):
            if not matches_binding(status, binding) or status.get("revoked"):
                raise BindingMissing("expected browser binding is missing")
            if not connected:
                return
            if status.get("connected"):
                if not status.get("replacement_pending"):
                    return
                state = resolve_binding(page, "confirm", binding["revision"])
                if state == "active":
                    return
                if state == "invalid":
                    raise BindingMissing("candidate binding is no longer valid")
        time.sleep(0.1)
    raise TimeoutError("browser binding did not complete")


def resolve_binding(page, action: str, revision: int) -> str:
    reply = extension_request(
        page,
        {"type": "platform_binding", "action": action, "revision": revision},
        timeout=12,
    )
    if not reply or not reply.get("ok"):
        raise ValueError("binding resolution failed")
    return reply["state"]


def published_binding(status: dict) -> dict:
    """读取扩展保存的已提交版本。"""
    return {
        "browser_origin": status["server"],
        "device_id": status["device_id"],
        "revision": status["platform_revision"],
    }


@contextmanager
def profile_lock(home: Path):
    """CLI 首绑与运行进程互斥，进程退出时释放锁。"""
    with (home / "profile.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield


def describe(home: Path, context=None) -> dict:
    """运行中从扩展回读绑定，只有明确丢失才清理已确认的记录。"""
    binding = binding_for(home)
    if context is None:
        return {**binding, "status": "bound"} if binding else {"status": "unbound"}
    try:
        with connection_page(context) as page:
            status = profile_status(page, timeout=1)
    except Error as exc:
        raise TimeoutError("browser binding could not be read") from exc
    if status.get("replacement_pending"):
        return {**binding, "status": "running", "connected": False} if binding else {"status": "unbound"}
    if status.get("configured") and not status.get("revoked"):
        if status.get("platform_revision") is not None and status.get("connected"):
            current = published_binding(status)
            if binding != current:
                save_binding(home, current)
                binding = current
        if binding and matches_binding(status, binding, legacy=True):
            return {**binding, "status": "running", "connected": status.get("connected") is True}
    if binding and not status.get("authorizing"):
        (home / "binding.json").unlink(missing_ok=True)
    return {"status": "unbound"}


def platform_binding(data: dict) -> dict:
    """校验私有平台交接，后续只使用已确认的单一来源。"""
    origin = valid_origin(data["browser_origin"], data.get("http_confirmed_origin") == data["browser_origin"])
    device_id, revision = data["device_id"], data["revision"]
    if not isinstance(device_id, str) or not device_id or type(revision) is not int or revision < 1:
        raise ValueError("invalid browser registration")
    return {"browser_origin": origin, "device_id": device_id, "revision": revision}


def redeem_binding(binding: dict, token) -> dict:
    """为候选版本兑换设备凭据。"""
    if not isinstance(token, str) or not token:
        raise ValueError("browser ticket required")
    device = device_request(
        binding["browser_origin"], "/api/managed-browsers/redeem",
        body={"device_id": binding["device_id"], "bootstrap_token": token},
    )
    if device["device_id"] != binding["device_id"] or device.get("revision") != binding["revision"]:
        raise ValueError("unexpected browser identity")
    return device


def settle_interrupted_binding(page, home: Path, binding: dict, status: dict, token) -> dict:
    """恢复上一轮交接。即使上一次提交回执丢失，也以 Server 生效版本为准。"""
    candidate_revision = status.get("platform_revision")
    if status.get("replacement_pending"):
        if matches_binding(status, binding) and not status.get("revoked"):
            if resolve_binding(page, "resume", candidate_revision) != "invalid":
                return profile_status(page)
            if not token:
                raise ValueError("candidate could not be verified; a fresh ticket is required")
        if resolve_binding(page, "abort", candidate_revision) == "active":
            save_binding(home, published_binding(status))
            if candidate_revision > binding["revision"]:
                raise ValueError("a newer browser binding is already active")
        return profile_status(page)
    if type(candidate_revision) is int and candidate_revision > binding["revision"]:
        if status.get("connected"):
            save_binding(home, published_binding(status))
        raise ValueError("a newer browser binding already exists")
    return status


def platform_start(page, home: Path, binding: dict, token) -> None:
    """只在候选登记已经生效后更新本机发布版本。"""
    status = settle_interrupted_binding(page, home, binding, profile_status(page), token)
    prior = binding_for(home)
    matches = matches_binding(status, binding, legacy=prior == binding) and not status.get("revoked")
    if matches and not status.get("replacement_pending") and prior == binding:
        if status.get("platform_revision") is None:
            resolve_binding(page, "resume", binding["revision"])
        return
    key = None if matches else redeem_binding(binding, token)["key"]
    try:
        if key is not None:
            bind(page, binding, key)
        verify_binding(page, binding, timeout=12, connected=True)
    except (Error, OSError, ValueError, KeyError):
        status = profile_status(page)
        if status.get("authorizing"):
            extension_request(page, {"type": "authorize_cancel"}, timeout=3)
        if (
            status.get("replacement_pending")
            and matches_binding(status, binding)
            and resolve_binding(page, "abort", binding["revision"]) == "active"
        ):
            save_binding(home, binding)
            return
        raise
    save_binding(home, binding)


def activate(playwright, home: Path, binding: dict, *, context=None, token=None, key=None):
    """沿用原 Profile。只有新启动的 Chromium 由本次失败关闭。"""
    current = context or open_browser(playwright, home, binding["browser_origin"])
    try:
        with connection_page(current) as page:
            if key is not None:
                bind(page, binding, key)
                verify_binding(page, binding)
                save_binding(home, binding)
            elif binding["revision"]:
                platform_start(page, home, binding, token)
            else:
                status = profile_status(page)
                if not matches_binding(status, binding) or status.get("revoked"):
                    (home / "binding.json").unlink(missing_ok=True)
                    raise BindingMissing("expected browser binding is missing")
        return current
    except (Error, OSError, ValueError, KeyError, TypeError):
        if context is None:
            current.close()
        raise


def serve(home: Path, foreground: bool) -> None:
    """监督单个 Chromium，Cube 可通过私有 socket 调用固定动作。"""
    with profile_lock(home), sync_playwright() as playwright:
        endpoint = home / "control.sock"
        endpoint.unlink(missing_ok=True)
        context = None
        try:
            if foreground:
                binding = binding_for(home)
                if binding is None:
                    raise ValueError("browser is unbound")
                context = activate(playwright, home, binding)
            with socket.socket(socket.AF_UNIX) as listener:
                listener.bind(str(endpoint))
                listener.listen(2)
                listener.settimeout(2)
                while True:
                    try:
                        client, _ = listener.accept()
                    except TimeoutError:
                        if context is not None:
                            context.cookies("https://example.invalid/")
                        continue
                    with client, client.makefile("rb") as stream:
                        client.settimeout(2)
                        stop = False
                        try:
                            message = json.loads(stream.readline(MAX_MESSAGE + 1))
                            match message["action"]:
                                case "start" if not foreground:
                                    handoff = message["handoff"]
                                    binding = platform_binding(handoff)
                                    prior = binding_for(home)
                                    if prior and (
                                        prior["browser_origin"] != binding["browser_origin"]
                                        or prior["device_id"] != binding["device_id"]
                                        or prior["revision"] > binding["revision"]
                                    ):
                                        raise ValueError("binding version or origin changed")
                                    context = activate(
                                        playwright, home, binding, context=context,
                                        token=handoff.get("bootstrap_token"),
                                    )
                                case "stop":
                                    if context is not None:
                                        context.close()
                                        context = None
                                    stop = True
                                case "status":
                                    pass
                                case _:
                                    raise ValueError("invalid action")
                            result = describe(home, context)
                        except Error:
                            with suppress(OSError):
                                client.sendall(json.dumps(FAILED).encode() + b"\n")
                            raise
                        except (OSError, ValueError, KeyError, TypeError):
                            result = FAILED
                        with suppress(OSError):
                            client.sendall(json.dumps(result).encode() + b"\n")
                        if stop:
                            return
        finally:
            endpoint.unlink(missing_ok=True)
            if context is not None:
                with suppress(Error):
                    context.close()


def request_service(home: Path, action: str) -> dict:
    """读取有界交接数据，只有 start 可创建监督进程。"""
    message = {"action": action}
    if action == "start":
        message["handoff"] = json.loads(sys.stdin.buffer.readline(MAX_MESSAGE + 1))
    payload = json.dumps(message).encode() + b"\n"
    if len(payload) > MAX_MESSAGE:
        raise ValueError("control request too large")
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(65 if action == "start" else 7)
        endpoint = str(home / "control.sock")
        try:
            client.connect(endpoint)
        except (FileNotFoundError, ConnectionRefusedError):
            if action != "start":
                # 正在启动的进程持锁；此时不能把缺失的 socket 判成未绑定。
                with profile_lock(home):
                    return describe(home)
            subprocess.Popen(
                [sys.executable, "-I", __file__, "_serve"],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            for _ in range(50):
                try:
                    client.connect(endpoint)
                    break
                except (FileNotFoundError, ConnectionRefusedError):
                    time.sleep(0.1)
            else:
                raise ValueError("browser supervisor did not start")
        client.sendall(payload)
        with client.makefile("rb") as stream:
            return json.loads(stream.readline(MAX_MESSAGE + 1))


def main() -> None:
    """安装配置由系统账户拥有。长期凭据仅由扩展持久化。"""
    parser = argparse.ArgumentParser(prog="abridge-client-browser")
    commands = parser.add_subparsers(dest="action", required=True)
    pair = commands.add_parser("bind", help="bind a Browser Device Key")
    pair.add_argument("--server", required=True, help="public aBridge origin")
    pair.add_argument("--stdin", action="store_true", help="read the key from private stdin")
    pair.add_argument("--allow-http", action="store_true", help="confirm a specific HTTP origin")
    for command in ("run", "status", "start", "stop", "_serve"):
        commands.add_parser(command)
    args = parser.parse_args()

    os.umask(0o077)
    account_home = Path(pwd.getpwuid(os.getuid()).pw_dir)
    home = Path(os.environ.get("ABRIDGE_BROWSER_HOME") or (account_home / ".local/state/abridge-client-browser"))
    home.mkdir(mode=0o700, parents=True, exist_ok=True)
    if home.stat().st_mode & 0o077 or home.stat().st_uid != os.getuid() or os.getuid() == 0:
        raise ValueError("run as a non-root account with a private state directory")
    bundled_browser = INSTALLATION / "chromium"
    if bundled_browser.exists():
        os.environ["PLAYWRIGHT_BROWSERS_PATH"] = str(bundled_browser)
    if args.action == "bind":
        origin = valid_origin(args.server, args.allow_http)
        if not args.stdin and not sys.stdin.isatty():
            raise ValueError("binding requires a terminal or private stdin")
        key = sys.stdin.readline(MAX_MESSAGE).strip() if args.stdin else getpass.getpass("Browser Device Key: ")
        with profile_lock(home), sync_playwright() as playwright:
            prior = binding_for(home)
            if prior and (prior["revision"] != 0 or prior["browser_origin"] != origin):
                raise ValueError("existing binding belongs to another origin or platform")
            device = device_request(origin, "/api/device", key=key)
            result = {"device_id": device["id"], "browser_origin": origin, "revision": 0}
            activate(playwright, home, result, key=key).close()
            print(json.dumps(describe(home)))
    elif args.action in {"run", "_serve"}:
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        serve(home, args.action == "run")
    else:
        result = request_service(home, args.action)
        print(json.dumps(result))
        if result == FAILED:
            sys.exit(1)


if __name__ == "__main__":
    try:
        main()
    except (Error, OSError, ValueError, KeyError, TypeError):
        sys.exit("Browser operation failed. Check the origin, credential and Chromium sandbox prerequisites.")
